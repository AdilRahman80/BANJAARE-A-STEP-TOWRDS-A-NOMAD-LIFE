# ==============================================================================
# Smart Trip Planner — Environment Configuration Template
# ==============================================================================
# NOTE: Smart Trip Planner is architected as a 100% client-side application.
# No secret API keys, database credentials, or private tokens are required.
#
# All variables below are OPTIONAL and prefixed with VITE_ for client-side access.
# ==============================================================================

# Application Branding (Optional)
VITE_APP_TITLE="Smart Trip Planner"

# Default Currency (Optional: USD | EUR | GBP | INR)
VITE_DEFAULT_CURRENCY="USD"

# Base URL (Optional, useful if hosting on a custom subdirectory or GitHub Pages)
# VITE_BASE_URL="/"
